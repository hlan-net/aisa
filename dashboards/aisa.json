        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(aisa_decide_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aisa_decide_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total p95",
          "range": true,
          "refId": "B"
