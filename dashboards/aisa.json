        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(aisa_decide_stage_duration_seconds_bucket[$__rate_interval])))",
