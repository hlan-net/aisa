{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Inference service overview for aisa: tokens per model, forward-auth decisions, end-to-end and TTFT latency, monthly consumer and provider budgets, backend health, ledger consistency, and top consumers.",
