        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aisa_decide_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total p99",
          "range": true,
          "refId": "C"
